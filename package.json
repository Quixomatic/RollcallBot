  "description": "Discord bot that monitors Meetup.com groups and posts event updates, RSVP changes, and comments",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "deploy-commands": "node src/deploy-commands.js",
    "reset-data": "node src/reset-data.js",
    "api-check": "node src/api-check.js",
