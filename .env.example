# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your-bot-token-here

# Application ID (Client ID) from the Discord developer portal
CLIENT_ID=your-client-id-here

# Where Meetup data comes from (default: graphql)
#   graphql  Meetup's GraphQL API over plain HTTP — fast, no browser needed for polling
#   browser  The original Playwright page scraper (v1 behaviour), kept as a fallback
# Both share the same session file and database, so switching is safe.
# See docs/meetup-api/README.md.
MEETUP_BACKEND=graphql

# Web dashboard. Set a password to enable it (served on DASHBOARD_PORT, default 3000).
DASHBOARD_PASSWORD=
# DASHBOARD_PORT=3000
# The dashboard's address as you open it, for links in Discord alerts:
# DASHBOARD_URL=http://192.168.1.10:3000

# Run Playwright in headless mode (default: true). Only used by the browser backend and login tools.
HEADLESS=true

# Default polling interval in minutes (default: 10)
DEFAULT_POLL_INTERVAL_MINUTES=10

# How many days out to track events (default: 30)
EVENT_HORIZON_DAYS=30
